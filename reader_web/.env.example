#
# Everything here is compiled into the browser bundle and is public.

VITE_SUPABASE_URL=https://rubukvxtiezyfxzqacsi.supabase.co
VITE_SUPABASE_KEY=sb_publishable_duXTls5l0OX4gtP2FFZSGg_0vbdMFWt

# The creator's own number. Share Your Story dials and WhatsApps it directly —
# placeholder until the real one is supplied.
VITE_CREATOR_PHONE=+260970000000
VITE_CREATOR_PHONE_DISPLAY=+260 97 000 0000

# Facebook sign-in needs no variable here, and that is deliberate.
#
# The reader's Meta app (1099253556427023, a plain Facebook Login app) has its
# id and secret typed into Supabase -> Authentication -> Providers -> Facebook.
# Supabase builds the consent URL itself, so nothing about it reaches this
# bundle. A copy of the id here would read as configuration while being unable
# to affect anything, and would be free to drift from the real one.
#
# Do not confuse it with the AUTHOR app (2255628145003686), which publishes to
# the Facebook Page and is configured in author_web/.env.

# Printed on the privacy, terms and data-deletion pages. Meta's review will
# follow it, so it must be a mailbox someone actually reads.
VITE_CONTACT_EMAIL=privacy@javuapps.com
